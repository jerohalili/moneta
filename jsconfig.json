{
  "compilerOptions": {
    "checkJs": true,
    "strict": false,
    "noEmit": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["lib/**/*.js", "tests/**/*.mjs", "hooks/useNumericInput.js"],
  "exclude": ["node_modules", ".next"]
}
