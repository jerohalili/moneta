# Postgres connection string from your Neon project (Vercel → Storage →
# Neon, or console.neon.tech). Local dev: put the real value in .env.local
# (gitignored) — this file is only a template.
DATABASE_URL=

# Auth session signing secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public URL of the app. Local dev default shown; on Vercel set this to
# your production URL (e.g. https://moneta.vercel.app).
BETTER_AUTH_URL=http://localhost:3000

# Google OAuth — create at console.cloud.google.com (see CONTINUE.md for
# the exact redirect URIs). Leave empty to disable Google sign-in.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
